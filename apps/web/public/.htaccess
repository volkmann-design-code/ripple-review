# The hosted web app on Apache: static files only (D22). Other hosts need
# the same three things: the routes answered by index.html, the headers,
# and long caching for the hashed bundles only.

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Dot paths (the deploy's staging folder and file lists) are not public;
  # .well-known stays reachable for certificates.
  RewriteRule "(^|/)\.(?!well-known/)" - [R=404,L]

  # The app's routes (/settings, /<owner>/<repo>/pull/<n>) are answered by
  # index.html; a missing bundle stays a 404, so a stale tab fails loudly
  # instead of parsing HTML as JavaScript. Repository names may contain
  # dots, so the test is the extension of the bundles, not any dot.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !\.(js|css|map|json|txt|ico|png|svg|webmanifest)$
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # The user's GitHub token and Anthropic key live in this origin: scripts
  # only from here, network only to the two APIs, no frames, no forms.
  # style-src needs 'unsafe-inline' for Angular's component styles and
  # Shiki's token colours.
  Header always set Content-Security-Policy "default-src 'none'; script-src 'self'; worker-src 'self'; connect-src 'self' https://api.github.com https://api.anthropic.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; manifest-src 'self'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Strict-Transport-Security "max-age=31536000"

  # Hashed bundles never change; everything else is checked on every load.
  Header set Cache-Control "no-cache"
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
