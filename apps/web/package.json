{
  "name": "@ripple-review/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ng serve",
    "build": "ng build",
    "test:unit": "bun --bun vitest run src",
    "shots": "playwright test -c shots.config.ts"
  },
  "nx": {
    "targets": {
      "typecheck": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/web",
          "commands": [
            "./node_modules/.bin/ngc --noEmit --rootDir ../.. -p tsconfig.app.json",
            "../../node_modules/.bin/tsc --noEmit --rootDir ../.. -p tsconfig.worker.json"
          ],
          "parallel": false
        }
      },
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/web",
          "command": "./node_modules/.bin/ng build"
        },
        "outputs": [
          "{projectRoot}/dist"
        ]
      },
      "shots": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "options": {
          "cwd": "apps/web",
          "command": "./node_modules/.bin/playwright test -c shots.config.ts"
        },
        "outputs": [
          "{projectRoot}/shots/out"
        ],
        "cache": false
      }
    }
  },
  "dependencies": {
    "@angular/common": "22.2.5",
    "@angular/compiler": "22.2.5",
    "@angular/core": "22.2.5",
    "@angular/forms": "22.2.5",
    "@angular/platform-browser": "22.2.5",
    "@angular/router": "22.2.5",
    "@material-symbols/svg-400": "0.48.3",
    "rxjs": "7.8.2",
    "shiki": "4.6.0",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.5",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "tailwindcss": "4.3.5"
  }
}
